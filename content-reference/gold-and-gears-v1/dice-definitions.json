        "text_hash": "14790359989943718375",
        "parameters": []
      },
      {
        "role": "PassiveEffect",
        "text_en": "Obtains #1[i] Cosmic Fragment(s) for each Trotter defeated.",
        "text_zh_cn": "每击败1只扑满，获得#1[i]宇宙碎片。",
        "text_hash": "3114534170203516322",
        "parameters": [
          "80"
        ]
      },
      {
        "role": "PathBoostTrigger",
        "text_en": "For every #1 time(s) a passive effect is triggered, gain the Path Boost effect of the selected Path.",
        "text_zh_cn": "每触发#1次被动效果，获得所选命途的【命途强化】效果。",
